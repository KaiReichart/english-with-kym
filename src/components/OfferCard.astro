---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import type { OfferCardContent } from '../i18n/types';

interface Props {
	card: OfferCardContent;
	image: ImageMetadata;
}

const { card, image } = Astro.props;
---

<article class="card">
	<div class="card-media">
		<Image
			src={image}
			alt={card.imageAlt}
			width={480}
			height={320}
			widths={[280, 380, 480]}
			sizes="(min-width: 860px) 360px, 90vw"
			format="webp"
			loading="lazy"
		/>
	</div>
	<Icon name={card.icon} class="card-icon" />
	<h3>{card.title}</h3>
	<p class="card-subtitle">{card.subtitle}</p>
	{card.intro.map((p) => <p>{p}</p>)}
	{card.leadIn && <p>{card.leadIn}</p>}
	{
		card.bullets && (
			<ul>
				{card.bullets.map((item) => (
					<li>{item}</li>
				))}
			</ul>
		)
	}
	{card.outro.map((p) => <p>{p}</p>)}
</article>

<style>
	.card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		padding: 2rem;
		height: 100%;
	}

	.card-media {
		margin: -2rem -2rem 1.25rem;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		border-radius: var(--radius) var(--radius) 0 0;
	}

	.card-media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.card-icon {
		color: var(--color-primary);
		width: 2.25em;
		height: 2.25em;
		margin-bottom: 0.75rem;
	}

	.card-subtitle {
		font-weight: 600;
		color: var(--color-primary-dark);
	}

	.card :global(p:last-of-type) {
		font-weight: 600;
		color: var(--color-heading);
		margin-bottom: 0;
	}
</style>
