---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const variants = [
	['01', 'Editorial', 'Magazin-Layout mit großer Serifenschrift'],
	['02', 'Swiss Style', 'Strenges Raster, große Typografie, Rot als Akzent'],
	['03', "Teacher's Notebook", 'Notizbuch, Klebezettel, Handschrift'],
	['04', 'Neo-Brutalism', 'Dicke Rahmen, harte Schatten, kräftige Farben'],
	['05', 'The Schwabmünchen Line', 'Britisch: Penguin-Cover & Underground'],
	['06', 'Pastellwolke', 'Pastell, rund, freundlich für Schüler & Eltern'],
	['07', 'The Private Study', 'Dunkel & Gold, Premium-Coaching'],
	['08', 'Trusted Advisor', 'Klar & seriös, Business-Look'],
	['09', 'Groovy', 'Retro 70er, Orange & Senf'],
	['10', 'Stille Stunden', 'Skandinavisch ruhig, Naturtöne'],
];
---
<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<title>Design-Varianten – English with Kym</title>
		<style>
			body { font-family: system-ui, sans-serif; max-width: 44rem; margin: 3rem auto; padding: 0 1.25rem; color: #1d1d1f; line-height: 1.5; }
			h1 { font-size: 1.75rem; margin-bottom: 0.25rem; }
			ol { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
			a { display: flex; gap: 1rem; padding: 0.9rem 1rem; border: 1px solid #ddd; border-radius: 0.5rem; text-decoration: none; color: inherit; }
			a:hover, a:focus-visible { border-color: #1d1d1f; }
			b { font-variant-numeric: tabular-nums; }
			span { color: #555; }
		</style>
	</head>
	<body>
		<main>
			<h1>Design-Varianten</h1>
			<p>Zehn unabhängige Entwürfe der Startseite. Aktuelle Seite: <a style="display:inline;border:0;padding:0;text-decoration:underline" href={base}>Startseite</a></p>
			<ol>
				{variants.map(([n, name, desc]) => (
					<li><a href={`${base}v/${n}/`}><b>{n}</b><span><strong style="color:#1d1d1f">{name}</strong> – {desc}</span></a></li>
				))}
			</ol>
		</main>
	</body>
</html>
