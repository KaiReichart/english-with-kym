---
import '@fontsource-variable/inter';
import '@fontsource/libre-baskerville/400.css';
import '@fontsource/libre-baskerville/400-italic.css';
import '@fontsource/libre-baskerville/700.css';
import '../../../variants/v05a/variant.css';
import Icon from '../../../variants/v05a/components/Icon.astro';
import StationMark from '../../../variants/v05a/components/StationMark.astro';
import Plate from '../../../variants/v05a/components/Plate.astro';
import { copy } from '../../../variants/v05a/copy';
import { Image } from 'astro:assets';
import heroImg from '../../../assets/images/hero.jpg';
import nachhilfeImg from '../../../assets/images/nachhilfe.jpg';
import businessImg from '../../../assets/images/business.jpg';
import conversationImg from '../../../assets/images/conversation.jpg';
import londonImg from '../../../assets/images/london.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const offerImages = [nachhilfeImg, businessImg, conversationImg];
const offerAccents = ['navy', 'red', 'navy'] as const;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{copy.meta.title}</title>
		<meta name="robots" content="noindex" />
		<meta name="description" content={copy.meta.description} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
	</head>
	<body class="v05a">
		<a class="skip-link" href="#main">{copy.skipLink}</a>

		<div class="triband" aria-hidden="true"><span></span><span></span><span></span></div>

		<header class="site">
			<div class="wrap header-row">
				<a class="brand" href={`${base}/`}>
					{copy.brand.name}
					<small>{copy.brand.place}</small>
				</a>
				<nav class="main" aria-label="Hauptnavigation">
					<ul>
						<li><a href="#angebot">{copy.nav.offer}</a></li>
						<li><a href="#ueber-kym">{copy.nav.about}</a></li>
						<li><a href="#unterricht">{copy.nav.lessons}</a></li>
						<li><a href="#kontakt">{copy.nav.contact}</a></li>
					</ul>
				</nav>
			</div>
			<div class="triband thin" aria-hidden="true"><span></span><span></span><span></span></div>
		</header>

		<main id="main">
			<!-- Hero: composed like a book cover -->
			<section class="hero">
				<div class="wrap hero-grid">
					<div class="hero-jacket">
						<div class="cover-panel">
							<p class="cover-band">{copy.hero.kicker}</p>
							<div class="cover-body">
								<h1>
									{copy.hero.titleLines.map((line, i) => (
										<>
											{i > 0 && <br />}
											{line}
										</>
									))}
								</h1>
								<p class="byline">
									<span class="byline-label">{copy.hero.bylineLabel}</span>
									<span class="byline-name">{copy.hero.bylineName}</span>
								</p>
								<hr class="cover-rule" />
								<p class="cover-intro">{copy.hero.intro}</p>
							</div>
						</div>
						<p class="hero-infoline">{copy.hero.infoLine}</p>
						<div class="btn-row">
							<a class="btn btn-red" href="#kontakt">{copy.hero.ctaPrimary}</a>
							<a class="btn btn-outline" href="#angebot">{copy.hero.ctaSecondary}</a>
						</div>
					</div>
					<Plate class="hero-plate">
						<Image src={heroImg} alt={copy.hero.imageAlt} width={480} height={600} format="webp" />
					</Plate>
				</div>
			</section>

			<!-- Learn / philosophy -->
			<section class="learn">
				<div class="wrap">
					<div class="section-head">
						<StationMark label={copy.learn.station} />
						<h2>{copy.learn.heading}</h2>
					</div>
					<div class="plaque">
						{copy.learn.paragraphs.map((p) => <p>{p}</p>)}
					</div>
				</div>
			</section>

			<!-- Offers -->
			<section class="offers" id="angebot">
				<div class="wrap">
					<div class="section-head">
						<StationMark label={copy.offers.station} />
						<h2>{copy.offers.heading}</h2>
					</div>
					<div class="offer-list">
						{
							copy.offers.cards.map((offer, i) => (
								<article class="offer-card" data-accent={offerAccents[i]}>
									<div class="offer-media">
										<Image src={offerImages[i]} alt={offer.imageAlt} width={400} height={300} format="webp" />
										<span class="offer-no">N° {i + 1}</span>
									</div>
									<div class="offer-body">
										<h3>{offer.title}</h3>
										<p class="offer-subtitle">{offer.subtitle}</p>
										{offer.intro.map((p) => (
											<p>{p}</p>
										))}
										{offer.leadIn && <p class="offer-lead-in">{offer.leadIn}</p>}
										{offer.bullets.length > 0 && (
											<ul class="ticklist">
												{offer.bullets.map((b) => (
													<li>
														<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
															<path d="M4 10.5 8 14l8-9" />
														</svg>
														<span>{b}</span>
													</li>
												))}
											</ul>
										)}
										{offer.outro.map((p) => (
											<p>{p}</p>
										))}
									</div>
								</article>
							))
						}
					</div>
				</div>
			</section>

			<!-- About -->
			<section class="about" id="ueber-kym">
				<div class="wrap">
					<div class="section-head">
						<StationMark label={copy.about.station} />
						<h2>{copy.about.heading}</h2>
					</div>
					<div class="about-grid">
						<Plate class="about-plate">
							<Image src={londonImg} alt={copy.about.imageAlt} width={440} height={330} format="webp" />
						</Plate>
						<div>
							<p class="lead">{copy.about.lead}</p>
							{copy.about.paragraphs.map((p) => <p>{p}</p>)}
						</div>
					</div>
				</div>
			</section>

			<!-- Lessons -->
			<section class="lessons" id="unterricht">
				<div class="wrap">
					<div class="section-head">
						<StationMark label={copy.lessons.station} />
						<h2>{copy.lessons.heading}</h2>
					</div>
					<div class="lessons-box">
						<p class="lessons-sub">{copy.lessons.subheading}</p>
						<ul class="info-items">
							{
								copy.lessons.items.map((item) => (
									<li>
										<Icon name={item.icon} />
										<span>{item.text}</span>
									</li>
								))
							}
						</ul>
						{copy.lessons.paragraphs.map((p) => <p>{p}</p>)}
					</div>
				</div>
			</section>

			<!-- Contact -->
			<section class="contact" id="kontakt">
				<div class="wrap">
					<div class="section-head">
						<StationMark label={copy.contact.station} />
						<h2>{copy.contact.heading}</h2>
					</div>
					<p class="lead">{copy.contact.lead}</p>
					<p class="body-text">{copy.contact.body}</p>
					<div class="btn-row">
						<a class="btn btn-red" href={`mailto:${copy.contact.email}`}>
							<Icon name="mail" />
							{copy.contact.email}
						</a>
						<a class="btn btn-outline" href={copy.contact.phoneHref}>
							<Icon name="phone" />
							{copy.contact.phone}
						</a>
					</div>
				</div>
			</section>
		</main>

		<footer class="site">
			<div class="wrap footer-row">
				<p class="footer-rights">&copy; {new Date().getFullYear()} {copy.brand.name} &middot; {copy.footer.tagline}</p>
				<nav aria-label="Rechtliches">
					<ul>
						<li><a href={`${base}/impressum`}>{copy.footer.impressum}</a></li>
						<li><a href={`${base}/datenschutz`}>{copy.footer.datenschutz}</a></li>
						<li><a href={`${base}/v/`}>{copy.footer.allVariants}</a></li>
					</ul>
				</nav>
			</div>
		</footer>
	</body>
</html>
