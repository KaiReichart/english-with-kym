---
import '@fontsource-variable/nunito';
import '@fontsource/caveat';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { de } from '../../../i18n/de';
import type { IconName } from '../../../i18n/types';
import { CONTACT } from '../../../consts';

import Icon from '../../../variants/v06/Icon.astro';
import WaveDivider from '../../../variants/v06/WaveDivider.astro';
import '../../../variants/v06/styles.css';

import heroImage from '../../../assets/images/hero.jpg';
import nachhilfeImage from '../../../assets/images/nachhilfe.jpg';
import businessImage from '../../../assets/images/business.jpg';
import conversationImage from '../../../assets/images/conversation.jpg';
import londonImage from '../../../assets/images/london.jpg';

const content = de;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const offerImages: Partial<Record<IconName, ImageMetadata>> = {
	graduation: nachhilfeImage,
	briefcase: businessImage,
	chat: conversationImage,
};

const lessonsIconMap: Record<string, 'pin' | 'clock' | 'calendar'> = {
	pin: 'pin',
	clock: 'clock',
	calendar: 'calendar',
};
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Variante 06 – English with Kym</title>
		<meta name="robots" content="noindex" />
		<meta name="description" content={content.meta.description} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
	</head>
	<body>
		<a class="skip-link" href="#main">{content.skipLink}</a>

		<header class="site-header">
			<div class="container header-inner">
				<a class="logo" href="#main">
					<span class="logo-dot" aria-hidden="true"></span>
					{content.hero.brand}
				</a>
				<nav class="main-nav" aria-label="Haupt">
					<ul>
						<li><a href="#angebot">{content.nav.offer}</a></li>
						<li><a href="#ueber-kym">{content.nav.about}</a></li>
						<li><a href="#unterricht">{content.nav.lessons}</a></li>
						<li><a href="#kontakt">{content.nav.contact}</a></li>
					</ul>
				</nav>
				<a class="btn btn-primary header-cta" href="#kontakt">{content.hero.cta}</a>
			</div>
		</header>

		<main id="main">
			<!-- 01 Hero -->
			<section class="section hero" aria-labelledby="hero-heading">
				<div class="container hero-inner section-inner">
					<div class="hero-content">
						<span class="hero-tagline-pill">{content.hero.tagline}</span>
						<h1 id="hero-heading">{content.hero.subtitle}</h1>
						<p class="hero-subtitle">{content.hero.brand}</p>
						<p class="hero-intro">{content.hero.intro}</p>
						<p class="hero-info">{content.hero.infoLine}</p>
						<div class="hero-actions">
							<a class="btn btn-primary" href="#kontakt">{content.hero.cta}</a>
							<a class="btn btn-secondary" href="#angebot">{content.nav.offer}</a>
						</div>
					</div>
					<div class="hero-media">
						<div class="hero-blob-frame">
							<span class="blob blob--float" aria-hidden="true"></span>
							<Image
								src={heroImage}
								alt={content.hero.imageAlt}
								width={420}
								height={315}
								widths={[320, 420, 640]}
								sizes="(min-width: 900px) 420px, 80vw"
								format="webp"
								loading="eager"
								fetchpriority="high"
							/>
						</div>
					</div>
				</div>
			</section>
			<WaveDivider fill="#e7dbfb" />

			<!-- 02 Learn -->
			<section class="section learn" aria-labelledby="learn-heading">
				<div class="container section-inner">
					<div class="learn-card">
						<span class="blob" aria-hidden="true"></span>
						<span class="eyebrow">
							<span class="eyebrow-number">02</span>
							Selbstvertrauen
						</span>
						<h2 id="learn-heading" class="section-heading">{content.learn.heading}</h2>
						<div class="learn-paragraphs">
							{content.learn.paragraphs.map((p) => <p>{p}</p>)}
						</div>
					</div>
				</div>
			</section>
			<WaveDivider fill="#fffaf2" flip />

			<!-- 03 Offer -->
			<section class="section offer" id="angebot" aria-labelledby="offer-heading">
				<div class="container section-inner">
					<span class="eyebrow">
						<span class="eyebrow-number">03</span>
						So kann ich helfen
					</span>
					<h2 id="offer-heading" class="section-heading">{content.offerHeading}</h2>

					<div class="offer-grid">
						{
							content.offers.map((offer) => {
								const img = offerImages[offer.icon];
								return (
									<article class="offer-card">
										{img && (
											<div class="offer-media">
												<Image
													src={img}
													alt={offer.imageAlt}
													width={320}
													height={240}
													widths={[280, 320, 480]}
													sizes="(min-width: 1180px) 320px, (min-width: 760px) 45vw, 90vw"
													format="webp"
													loading="lazy"
												/>
												<span class="offer-icon-badge">
													<Icon name={offer.icon} size={24} />
												</span>
											</div>
										)}
										<h3>{offer.title}</h3>
										<p class="offer-subtitle">{offer.subtitle}</p>
										{offer.intro.map((p) => <p class="offer-text">{p}</p>)}
										{offer.leadIn && <p class="offer-leadin">{offer.leadIn}</p>}
										{offer.bullets && (
											<ul class="offer-bullets">
												{offer.bullets.map((b) => (
													<li>
														<span class="check-badge">
															<Icon name="check" size={13} />
														</span>
														{b}
													</li>
												))}
											</ul>
										)}
										{offer.outro.map((p) => <p class="offer-text">{p}</p>)}
									</article>
								);
							})
						}
					</div>
				</div>
			</section>
			<WaveDivider fill="#bee3f8" />

			<!-- 04 About -->
			<section class="section about" id="ueber-kym" aria-labelledby="about-heading">
				<div class="container section-inner">
					<div class="about-grid about-grid--reverse">
						<div class="about-media">
							<div class="about-blob-frame">
								<span class="blob blob--float" aria-hidden="true"></span>
								<Image
									src={londonImage}
									alt={content.about.imageAlt}
									width={360}
									height={360}
									widths={[280, 360, 480]}
									sizes="(min-width: 900px) 360px, 70vw"
									format="webp"
									loading="lazy"
								/>
							</div>
						</div>
						<div>
							<span class="eyebrow">
								<span class="eyebrow-number">04</span>
								Hallo!
							</span>
							<h2 id="about-heading" class="section-heading">{content.about.heading}</h2>
							<p class="about-lead">{content.about.lead}</p>
							<div class="about-paragraphs">
								{content.about.paragraphs.map((p) => <p>{p}</p>)}
							</div>
							<p class="about-signature">– Kym</p>
						</div>
					</div>
				</div>
			</section>
			<WaveDivider fill="#cff4d2" flip />

			<!-- 05 Lessons -->
			<section class="section lessons" id="unterricht" aria-labelledby="lessons-heading">
				<div class="container section-inner">
					<span class="eyebrow">
						<span class="eyebrow-number">05</span>
						Wann &amp; wo
					</span>
					<h2 id="lessons-heading" class="section-heading">{content.lessons.heading}</h2>
					<p class="section-lead">{content.lessons.subheading}</p>

					<div class="lessons-items">
						{
							content.lessons.items.map((item) => (
								<div class="lessons-item">
									<span class="icon-badge">
										<Icon name={lessonsIconMap[item.icon] ?? 'pin'} size={20} />
									</span>
									{item.text}
								</div>
							))
						}
					</div>

					<div class="lessons-paragraphs">
						{content.lessons.paragraphs.map((p) => <p>{p}</p>)}
					</div>
				</div>
			</section>
			<WaveDivider fill="#352a49" />

			<!-- 06 Contact -->
			<section class="section contact" id="kontakt" aria-labelledby="contact-heading">
				<div class="container section-inner">
					<span class="eyebrow">
						<span class="eyebrow-number">06</span>
						Let's talk!
					</span>
					<h2 id="contact-heading" class="section-heading">{content.contact.heading}</h2>

					<div class="contact-card">
						<div>
							<p class="contact-lead">{content.contact.lead}</p>
							<p class="contact-body">{content.contact.body}</p>
							<p class="contact-tagline">{content.contact.tagline}</p>
						</div>
						<div class="contact-links">
							<a class="contact-link" href={`mailto:${CONTACT.email}`}>
								<span class="icon-badge">
									<Icon name="mail" size={20} />
								</span>
								{CONTACT.email}
							</a>
							<a class="contact-link" href={`tel:${CONTACT.phone}`}>
								<span class="icon-badge">
									<Icon name="phone" size={20} />
								</span>
								{CONTACT.phoneDisplay}
							</a>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="container">
				<div class="footer-inner">
					<div>
						<p class="footer-brand">{content.footer.rights}</p>
						<p class="footer-tagline">{content.footer.tagline}</p>
					</div>
					<ul class="footer-links">
						<li><a href={`${base}/impressum`}>{content.footer.impressum}</a></li>
						<li><a href={`${base}/datenschutz`}>{content.footer.datenschutz}</a></li>
					</ul>
				</div>
				<div class="footer-bottom">
					<p>© {new Date().getFullYear()} {content.footer.rights}</p>
					<a class="variants-link" href={`${base}/v/`}>Alle Varianten</a>
				</div>
			</div>
		</footer>
	</body>
</html>
