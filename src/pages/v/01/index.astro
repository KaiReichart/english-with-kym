---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/lora';
import '@fontsource-variable/space-grotesk';
import { Image } from 'astro:assets';
import { de } from '../../../i18n/de';
import heroImg from '../../../assets/images/hero.jpg';
import nachhilfeImg from '../../../assets/images/nachhilfe.jpg';
import businessImg from '../../../assets/images/business.jpg';
import conversationImg from '../../../assets/images/conversation.jpg';
import londonImg from '../../../assets/images/london.jpg';
import SectionKicker from '../../../variants/v01/components/SectionKicker.astro';
import PullQuote from '../../../variants/v01/components/PullQuote.astro';
import OfferArticle from '../../../variants/v01/components/OfferArticle.astro';
import Divider from '../../../variants/v01/components/Divider.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();

const offerImages = [nachhilfeImg, businessImg, conversationImg];

function dropCap(text: string) {
	return { first: text.slice(0, 1), rest: text.slice(1) };
}

const learnLead = dropCap(de.learn.paragraphs[0]);
const aboutLead = dropCap(de.about.paragraphs[0]);

const CONTACT = {
	email: 'kym-elizabeth@gmx.de',
	phone: '+4915140462441',
	phoneDisplay: '0151 40462441',
};
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Variante 01 – English with Kym</title>
		<meta name="description" content={de.meta.description} />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
	</head>
	<body>
		<a class="skip-link" href="#main">{de.skipLink}</a>

		<header class="masthead">
			<div class="masthead-inner">
				<p class="masthead-title">{de.hero.brand}</p>
				<nav aria-label="Hauptnavigation">
					<ul>
						<li><a href="#angebot">{de.nav.offer}</a></li>
						<li><a href="#ueber-kym">{de.nav.about}</a></li>
						<li><a href="#unterricht">{de.nav.lessons}</a></li>
						<li><a href="#kontakt">{de.nav.contact}</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<main id="main">
			<!-- Hero -->
			<section class="hero">
				<figure class="hero-figure">
					<Image
						src={heroImg}
						alt={de.hero.imageAlt}
						width={480}
						height={320}
						format="webp"
						loading="eager"
					/>
					<figcaption>{de.hero.imageAlt}</figcaption>
				</figure>
				<div class="hero-copy">
					<p class="rubric">{de.hero.tagline}</p>
					<h1>{de.hero.subtitle}</h1>
					<p class="hero-intro">{de.hero.intro}</p>
					<p class="hero-infoline">{de.hero.infoLine}</p>
					<a class="cta" href="#kontakt">
						{de.hero.cta}
						<svg viewBox="0 0 20 10" aria-hidden="true" focusable="false">
							<path
								d="M0 5h17M12 0l5 5-5 5"
								fill="none"
								stroke="currentColor"
								stroke-width="1.4"
							></path>
						</svg>
					</a>
				</div>
			</section>

			<!-- Learn -->
			<section class="section learn" aria-labelledby="learn-heading">
				<SectionKicker number="01" />
				<h2 id="learn-heading">{de.learn.heading}</h2>
				<div class="columns">
					<p class="drop-cap">
						<span class="drop-cap-letter">{learnLead.first}</span>{learnLead.rest}
					</p>
					{de.learn.paragraphs.slice(1).map((p) => <p>{p}</p>)}
				</div>
				<PullQuote quote="Mein Unterricht ist entspannt, praxisnah und auf dich abgestimmt – denn jeder Mensch lernt anders." />
			</section>

			<Divider />

			<!-- Offer -->
			<section class="section offers" aria-labelledby="offer-heading" id="angebot">
				<SectionKicker number="02" />
				<h2 id="offer-heading">{de.offerHeading}</h2>
				{
					de.offers.map((offer, i) => (
						<OfferArticle
							number={`0${i + 1}`}
							offer={offer}
							image={offerImages[i]}
							reverse={i % 2 === 1}
						/>
					))
				}
				<PullQuote quote="Das Ziel ist nicht perfektes Englisch, sondern Englisch mit Selbstvertrauen!" />
			</section>

			<Divider />

			<!-- About -->
			<section class="section about" aria-labelledby="about-heading" id="ueber-kym">
				<SectionKicker number="03" />
				<h2 id="about-heading">{de.about.heading}</h2>
				<p class="lede">{de.about.lead}</p>
				<div class="about-grid">
					<figure class="about-figure">
						<Image
							src={londonImg}
							alt={de.about.imageAlt}
							width={480}
							height={340}
							format="webp"
							loading="lazy"
						/>
						<figcaption>{de.about.imageAlt}</figcaption>
					</figure>
					<div class="columns about-text">
						<p class="drop-cap">
							<span class="drop-cap-letter">{aboutLead.first}</span>{aboutLead.rest}
						</p>
						{de.about.paragraphs.slice(1).map((p) => <p>{p}</p>)}
					</div>
				</div>
			</section>

			<Divider />

			<!-- Lessons -->
			<section class="section lessons" aria-labelledby="lessons-heading" id="unterricht">
				<SectionKicker number="04" />
				<h2 id="lessons-heading">{de.lessons.heading}</h2>
				<p class="rubric">{de.lessons.subheading}</p>
				<ul class="facts">
					{de.lessons.items.map((item) => <li>{item.text}</li>)}
				</ul>
				{de.lessons.paragraphs.map((p) => <p>{p}</p>)}
			</section>

			<Divider />

			<!-- Contact -->
			<section class="section contact" aria-labelledby="contact-heading" id="kontakt">
				<SectionKicker number="05" />
				<h2 id="contact-heading">{de.contact.heading}</h2>
				<p class="lede">{de.contact.lead}</p>
				<p>{de.contact.body}</p>
				<div class="contact-block">
					<p class="contact-brand">{de.contact.brand}</p>
					<p class="rubric">{de.contact.tagline}</p>
					<p class="contact-links">
						<a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
						<a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneDisplay}</a>
					</p>
					<a class="cta" href={`mailto:${CONTACT.email}`}>
						{de.contact.cta}
						<svg viewBox="0 0 20 10" aria-hidden="true" focusable="false">
							<path
								d="M0 5h17M12 0l5 5-5 5"
								fill="none"
								stroke="currentColor"
								stroke-width="1.4"
							></path>
						</svg>
					</a>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<Divider />
			<div class="footer-inner">
				<div>
					<p class="footer-brand">{de.hero.brand}</p>
					<p class="footer-tagline">{de.footer.tagline}</p>
				</div>
				<nav aria-label="Rechtliches">
					<ul>
						<li><a href={`${base}/impressum`}>{de.footer.impressum}</a></li>
						<li><a href={`${base}/datenschutz`}>{de.footer.datenschutz}</a></li>
						<li><a href={`${base}/v/`}>Alle Varianten</a></li>
					</ul>
				</nav>
			</div>
			<p class="copyright">&copy; {year} {de.footer.rights}</p>
		</footer>

		<style>
			:global(:root) {
				--paper: #f6f1e6;
				--surface: #efe7d4;
				--ink: #201a15;
				--ink-soft: #564e44;
				--accent: #8a3220;
				--rule: #ddd2bc;
				--rule-strong: #c7b89d;
				--font-display: 'Fraunces Variable', 'Fraunces', Georgia, serif;
				--font-body: 'Lora Variable', Lora, Georgia, serif;
				--font-label: 'Space Grotesk Variable', 'Space Grotesk', sans-serif;
			}

			:global(*) {
				box-sizing: border-box;
			}

			:global(html) {
				background: var(--paper);
			}

			:global(body) {
				margin: 0;
				background: var(--paper);
				color: var(--ink);
				font-family: var(--font-body);
				font-optical-sizing: auto;
				-webkit-font-smoothing: antialiased;
			}

			:global(img) {
				max-width: 100%;
			}

			.skip-link {
				position: absolute;
				left: -9999px;
				top: 0;
				background: var(--ink);
				color: var(--paper);
				padding: 0.75rem 1.25rem;
				font-family: var(--font-label);
				font-size: 0.9rem;
				z-index: 10;
			}

			.skip-link:focus {
				left: 1rem;
				top: 1rem;
			}

			:global(a) {
				color: var(--accent);
			}

			:global(a:focus-visible),
			:global(button:focus-visible) {
				outline: 2px solid var(--accent);
				outline-offset: 3px;
			}

			/* Masthead */
			.masthead {
				border-bottom: 1px solid var(--rule-strong);
				padding: 1.1rem 1.5rem;
				position: sticky;
				top: 0;
				background: var(--paper);
				z-index: 5;
			}

			.masthead-inner {
				max-width: 72rem;
				margin: 0 auto;
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.75rem 2rem;
			}

			.masthead-title {
				margin: 0;
				font-family: var(--font-display);
				font-weight: 600;
				font-size: 1.4rem;
				letter-spacing: 0.01em;
			}

			.masthead nav ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1.25rem 1.5rem;
				margin: 0;
				padding: 0;
				list-style: none;
			}

			.masthead nav a {
				font-family: var(--font-label);
				font-size: 0.78rem;
				font-weight: 500;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				text-decoration: none;
				color: var(--ink);
				border-bottom: 1px solid transparent;
			}

			.masthead nav a:hover {
				color: var(--accent);
				border-bottom-color: var(--accent);
			}

			main {
				max-width: 72rem;
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			/* Hero */
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 23rem) minmax(0, 1fr);
				gap: 2.5rem 3.5rem;
				align-items: start;
				padding: 3rem 0 2rem;
			}

			.hero-figure {
				margin: 0;
			}

			.hero-figure img {
				display: block;
				width: 100%;
				height: auto;
				filter: grayscale(0.2) sepia(0.1) saturate(1.05);
			}

			.hero-figure figcaption {
				margin-top: 0.6rem;
				font-style: italic;
				font-size: 0.85rem;
				color: var(--ink-soft);
			}

			.rubric {
				font-family: var(--font-label);
				font-size: 0.82rem;
				font-weight: 500;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 0.75rem;
			}

			.hero h1 {
				font-family: var(--font-display);
				font-weight: 580;
				font-size: clamp(2.5rem, 1.8rem + 3vw, 4.25rem);
				line-height: 1.04;
				letter-spacing: -0.01em;
				margin: 0 0 1.25rem;
				font-variation-settings: 'SOFT' 20;
			}

			.hero-intro {
				font-size: 1.2rem;
				line-height: 1.6;
				margin: 0 0 1rem;
				max-width: 38ch;
			}

			.hero-infoline {
				font-style: italic;
				color: var(--ink-soft);
				margin: 0 0 1.75rem;
			}

			.cta {
				display: inline-flex;
				align-items: center;
				gap: 0.6rem;
				font-family: var(--font-label);
				font-size: 0.85rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				text-decoration: none;
				color: var(--ink);
				border-bottom: 1px solid var(--ink);
				padding-bottom: 0.3rem;
			}

			.cta svg {
				width: 1.1rem;
				height: 0.6rem;
				color: var(--accent);
			}

			.cta:hover {
				color: var(--accent);
				border-bottom-color: var(--accent);
			}

			/* Sections */
			.section {
				padding: 0.5rem 0 1rem;
			}

			.section h2 {
				font-family: var(--font-display);
				font-weight: 580;
				font-size: clamp(1.9rem, 1.5rem + 1.6vw, 2.75rem);
				line-height: 1.1;
				margin: 0 0 2rem;
				max-width: 24ch;
			}

			.columns {
				columns: 2;
				column-gap: 2.5rem;
			}

			.columns p {
				font-size: 1.05rem;
				line-height: 1.7;
				margin: 0 0 1.1rem;
			}

			.drop-cap-letter {
				float: left;
				font-family: var(--font-display);
				font-weight: 600;
				font-size: 3.6rem;
				line-height: 0.82;
				padding-right: 0.5rem;
				margin-top: 0.1rem;
				color: var(--accent);
			}

			.lede {
				font-family: var(--font-display);
				font-style: italic;
				font-weight: 440;
				font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.6rem);
				line-height: 1.45;
				max-width: 42ch;
				margin: 0 0 1.75rem;
			}

			/* About */
			.about-grid {
				display: grid;
				grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
				gap: 2rem 3rem;
				align-items: start;
			}

			.about-figure {
				margin: 0;
			}

			.about-figure img {
				display: block;
				width: 100%;
				height: auto;
				filter: grayscale(0.25) sepia(0.1) saturate(1.1);
			}

			.about-figure figcaption {
				margin-top: 0.6rem;
				font-style: italic;
				font-size: 0.85rem;
				color: var(--ink-soft);
			}

			/* Lessons */
			.facts {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem 2.5rem;
				list-style: none;
				margin: 0 0 2rem;
				padding: 1.25rem 0;
				border-top: 1px solid var(--rule-strong);
				border-bottom: 1px solid var(--rule-strong);
			}

			.facts li {
				font-family: var(--font-display);
				font-size: 1.15rem;
				font-weight: 500;
				position: relative;
				padding-left: 1.1rem;
			}

			.facts li::before {
				content: '';
				position: absolute;
				left: 0;
				top: 0.4em;
				width: 0.45rem;
				height: 0.45rem;
				background: var(--accent);
				border-radius: 50%;
			}

			.lessons > p {
				font-size: 1.05rem;
				line-height: 1.7;
				max-width: 60ch;
				margin: 0 0 1.1rem;
			}

			/* Contact */
			.contact > p {
				font-size: 1.1rem;
				line-height: 1.7;
				max-width: 50ch;
			}

			.contact-block {
				margin-top: 2.5rem;
				padding-top: 2rem;
				border-top: 1px solid var(--rule-strong);
			}

			.contact-brand {
				font-family: var(--font-display);
				font-weight: 600;
				font-size: 1.3rem;
				margin: 0 0 0.25rem;
			}

			.contact-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem 1.5rem;
				margin: 0.75rem 0 1.75rem;
			}

			.contact-links a {
				font-family: var(--font-display);
				font-size: clamp(1.3rem, 1.1rem + 1vw, 1.8rem);
				font-weight: 500;
				text-decoration: none;
				color: var(--ink);
				border-bottom: 1px solid var(--rule-strong);
			}

			.contact-links a:hover {
				color: var(--accent);
				border-bottom-color: var(--accent);
			}

			/* Footer */
			.site-footer {
				max-width: 72rem;
				margin: 0 auto;
				padding: 0 1.5rem 3rem;
			}

			.footer-inner {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-between;
				gap: 1.5rem;
				margin-bottom: 1.5rem;
			}

			.footer-brand {
				font-family: var(--font-display);
				font-weight: 600;
				margin: 0 0 0.25rem;
			}

			.footer-tagline {
				margin: 0;
				color: var(--ink-soft);
				font-size: 0.95rem;
			}

			.site-footer nav ul {
				display: flex;
				flex-wrap: wrap;
				gap: 1.25rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.site-footer nav a {
				font-family: var(--font-label);
				font-size: 0.78rem;
				font-weight: 500;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				text-decoration: none;
				color: var(--ink-soft);
			}

			.site-footer nav a:hover {
				color: var(--accent);
			}

			.copyright {
				margin: 0;
				font-size: 0.85rem;
				color: var(--ink-soft);
			}

			@media (prefers-reduced-motion: no-preference) {
				.cta,
				.masthead nav a,
				.contact-links a,
				.site-footer nav a {
					transition: color 0.15s ease, border-color 0.15s ease;
				}
			}

			@media (max-width: 860px) {
				.hero {
					grid-template-columns: 1fr;
				}

				.hero-figure {
					max-width: 22rem;
				}

				.about-grid {
					grid-template-columns: 1fr;
				}

				.about-figure {
					max-width: 20rem;
				}
			}

			@media (max-width: 680px) {
				.masthead {
					position: static;
				}

				.columns {
					columns: 1;
				}

				.section h2 {
					max-width: none;
				}
			}
		</style>
	</body>
</html>
