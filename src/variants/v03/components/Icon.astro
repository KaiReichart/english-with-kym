---
// Hand-drawn style icon set for variant 03 (functional icons from the
// content model, plus a few decorative marks used across the page).
// Sketchy look achieved with slightly irregular, rounded strokes.
interface Props {
	name:
		| 'graduation'
		| 'briefcase'
		| 'chat'
		| 'pin'
		| 'clock'
		| 'calendar'
		| 'mail'
		| 'phone'
		| 'pushpin'
		| 'paperclip'
		| 'star'
		| 'check'
		| 'arrow-right';
	class?: string;
}

const { name, class: className } = Astro.props;
---

{
	name === 'graduation' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<path d="M2.5 8.5 12 4l9.5 4.5L12 13 2.5 8.5Z" />
			<path d="M6.5 10.6v4.3c0 1.3 2.4 2.6 5.5 2.6s5.5-1.3 5.5-2.6v-4.3" />
			<path d="M21 9v6.2" />
		</svg>
	)
}
{
	name === 'briefcase' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<rect x="3" y="7.5" width="18" height="12" rx="1.5" />
			<path d="M8.5 7.5V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v1.5" />
			<path d="M3 12.5h18" />
			<path d="M10.8 12.5h2.4v1.8h-2.4z" />
		</svg>
	)
}
{
	name === 'chat' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<path d="M4 6.5c0-1.4 1.2-2.5 2.6-2.5h10.8c1.4 0 2.6 1.1 2.6 2.5v6.3c0 1.4-1.2 2.5-2.6 2.5H10l-4.3 3.4v-3.4H6.6C5.2 15.3 4 14.2 4 12.8V6.5Z" />
			<path d="M8 8.7h8M8 11.6h5.3" />
		</svg>
	)
}
{
	name === 'pin' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<path d="M12 21s7-6.3 7-11.5a7 7 0 0 0-14 0C5 14.7 12 21 12 21Z" />
			<circle cx="12" cy="9.3" r="2.4" />
		</svg>
	)
}
{
	name === 'clock' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<circle cx="12" cy="12" r="8.3" />
			<path d="M12 7.2V12l3.3 2" />
		</svg>
	)
}
{
	name === 'calendar' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<rect x="3.5" y="5" width="17" height="15.5" rx="1.6" />
			<path d="M3.5 9.7h17M8 3v4M16 3v4" />
			<path d="M7.8 13.3h2M11.3 13.3h2M14.8 13.3h2M7.8 16.6h2M11.3 16.6h2" />
		</svg>
	)
}
{
	name === 'mail' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<rect x="3" y="5.5" width="18" height="13" rx="1.6" />
			<path d="M4 7l8 6 8-6" />
		</svg>
	)
}
{
	name === 'phone' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<path d="M6.6 3.8 9.3 6.5c.5.5.5 1.3 0 1.9l-1.5 1.5a12 12 0 0 0 5.5 5.5l1.5-1.5c.5-.5 1.3-.5 1.9 0l2.7 2.7c.5.5.5 1.3 0 1.9l-1.3 1.3c-.7.7-1.7 1-2.7.8-4.4-.9-8.6-3.9-11.3-7.8C1.8 9.4.9 6 1.8 3.4L3.1 2c.5-.5 1.3-.5 1.9 0Z" />
		</svg>
	)
}
{
	name === 'pushpin' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<circle cx="12" cy="8" r="5" fill="currentColor" opacity="0.9" />
			<path d="M12 13v8" />
		</svg>
	)
}
{
	name === 'paperclip' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<path d="M7 11.5 15.3 3a3 3 0 0 1 4.3 4.3l-9.6 9.6a4.5 4.5 0 0 1-6.4-6.4L12.4 1.7" />
		</svg>
	)
}
{
	name === 'star' && (
		<svg viewBox="0 0 24 24" fill="currentColor" stroke="none" class={className} aria-hidden="true">
			<path d="M12 2.8 14.4 9l6.6.4-5.1 4.3 1.8 6.4L12 16.6 6.3 20.1l1.8-6.4-5.1-4.3L9.6 9Z" />
		</svg>
	)
}
{
	name === 'check' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<path d="M4 12.8 9 18 20 5.5" />
		</svg>
	)
}
{
	name === 'arrow-right' && (
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
			<path d="M3.5 12h16.5M14 6.5 20 12l-6 5.5" />
		</svg>
	)
}
