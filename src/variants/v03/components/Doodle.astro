---
// Hand-drawn decorative squiggles used to highlight headings and link
// margin notes to the text they annotate.
interface Props {
	type: 'underline' | 'underline-wavy' | 'circle' | 'arrow-down' | 'arrow-left';
	class?: string;
	style?: string;
}

const { type, class: className, ...attrs } = Astro.props;
---

{
	type === 'underline' && (
		<svg viewBox="0 0 200 20" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" class={className} aria-hidden="true" {...attrs}>
			<path d="M3 13c35-7 140-9 194 1" />
		</svg>
	)
}
{
	type === 'underline-wavy' && (
		<svg viewBox="0 0 200 20" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" class={className} aria-hidden="true" {...attrs}>
			<path d="M2 12c12-9 22 9 34 0s22-9 34 0 22 9 34 0 22-9 34 0 22 9 34 0 18-6 26-2" />
		</svg>
	)
}
{
	type === 'circle' && (
		<svg viewBox="0 0 120 60" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" class={className} aria-hidden="true" {...attrs}>
			<path d="M60 4C27 2 5 16 6 32c1 17 28 27 56 26 26-1 53-12 54-27C117 15 86 5 58 6" />
		</svg>
	)
}
{
	type === 'arrow-down' && (
		<svg viewBox="0 0 40 60" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true" {...attrs}>
			<path d="M20 2c-3 20 1 38-2 54" />
			<path d="M9 44c3 6 6 10 9 12 3-3 7-7 11-14" />
		</svg>
	)
}
{
	type === 'arrow-left' && (
		<svg viewBox="0 0 60 40" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true" {...attrs}>
			<path d="M58 20c-18 2-34 1-50 2" />
			<path d="M18 9c-5 4-9 8-10 13 4 2 9 3 16 4" />
		</svg>
	)
}
