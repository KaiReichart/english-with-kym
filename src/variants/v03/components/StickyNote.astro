---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { OfferCardContent } from '../../../i18n/types';
import Icon from './Icon.astro';

interface Props {
	offer: OfferCardContent;
	color: 'yellow' | 'pink' | 'mint';
	rotate: number;
	number: string;
	image: ImageMetadata;
}

const { offer, color, rotate, number, image } = Astro.props;
---

<article class={`sticky sticky--${color}`} style={`--rotate: ${rotate}deg`}>
	<Icon name="pushpin" class="sticky-pin" />
	<span class="sticky-number" aria-hidden="true">{number}</span>
	<div class="sticky-photo">
		<Image src={image} alt={offer.imageAlt} width={160} height={120} format="webp" />
	</div>
	<Icon name={offer.icon} class="sticky-icon" />
	<h3 class="sticky-title">{offer.title}</h3>
	<p class="sticky-subtitle">{offer.subtitle}</p>

	{offer.intro.map((p) => <p>{p}</p>)}

	{offer.leadIn && <p class="lead-in">{offer.leadIn}</p>}

	{
		offer.bullets && (
			<ul class="doodle-list">
				{offer.bullets.map((b) => (
					<li>
						<Icon name="check" />
						<span>{b}</span>
					</li>
				))}
			</ul>
		)
	}

	{offer.outro.map((p) => <p>{p}</p>)}
</article>

<style>
	.sticky {
		position: relative;
		background: var(--note-bg);
		border-bottom: 10px solid var(--note-edge);
		padding: 2rem 1.5rem 1.6rem;
		box-shadow: var(--shadow-note);
		transform: rotate(var(--rotate));
		transition: transform 0.2s ease;
	}

	@media (max-width: 480px) {
		.sticky {
			transform: none;
		}
	}

	.sticky:hover {
		transform: rotate(0deg) translateY(-3px);
	}

	.sticky--yellow {
		--note-bg: var(--sticky-yellow);
		--note-edge: var(--sticky-yellow-edge);
	}

	.sticky--pink {
		--note-bg: var(--sticky-pink);
		--note-edge: var(--sticky-pink-edge);
	}

	.sticky--mint {
		--note-bg: var(--sticky-mint);
		--note-edge: var(--sticky-mint-edge);
	}

	:global(.sticky-pin) {
		position: absolute;
		top: -1.1rem;
		left: 50%;
		transform: translateX(-50%);
		width: 2rem;
		height: 2rem;
		color: var(--accent-red-dark);
		filter: drop-shadow(0 3px 2px rgba(0, 0, 0, 0.35));
	}

	.sticky-number {
		position: absolute;
		top: 0.6rem;
		right: 0.9rem;
		font-family: 'Caveat', cursive;
		font-weight: 700;
		font-size: 1.5rem;
		color: rgba(44, 53, 80, 0.4);
	}

	.sticky-photo {
		float: right;
		width: 5.5rem;
		margin: 0 0 0.6rem 0.8rem;
		background: #fff;
		padding: 0.3rem;
		box-shadow: 0 4px 10px -4px rgba(0, 0, 0, 0.4);
		transform: rotate(3deg);
	}

	.sticky-photo :global(img) {
		display: block;
		width: 100%;
		height: auto;
		filter: sepia(0.1);
	}

	:global(.sticky-icon) {
		width: 2.2rem;
		height: 2.2rem;
		color: var(--accent-red-dark);
		margin-bottom: 0.4rem;
	}

	.sticky-title {
		font-size: 1.9rem;
		margin-bottom: 0.15rem;
	}

	.sticky-subtitle {
		font-weight: 700;
		color: var(--ink-soft);
		margin-bottom: 0.9rem;
		font-size: 1rem;
	}

	.sticky p,
	.sticky .doodle-list {
		font-size: 0.98rem;
	}

	.sticky :global(.doodle-list svg) {
		color: var(--accent-red-dark);
	}

	@media (max-width: 26rem) {
		.sticky-photo {
			width: 4.3rem;
		}
	}
</style>
