---
export type IconName =
	| 'graduation'
	| 'briefcase'
	| 'chat'
	| 'pin'
	| 'clock'
	| 'calendar'
	| 'mail'
	| 'phone'
	| 'arrow';

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className } = Astro.props;
---

{
	name === 'graduation' && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
			<path d="M2 8 12 3l10 5-10 5-10-5Z" />
			<path d="M6 10.5V16c0 1.1 2.7 2.5 6 2.5s6-1.4 6-2.5v-5.5" />
			<path d="M20.5 9v6" />
		</svg>
	)
}
{
	name === 'briefcase' && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
			<rect x="2.5" y="7" width="19" height="13" rx="1" />
			<path d="M8 7V5.5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2V7" />
			<path d="M2.5 13h19" />
		</svg>
	)
}
{
	name === 'chat' && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
			<path d="M3 5.5A2 2 0 0 1 5 3.5h14a2 2 0 0 1 2 2V15a2 2 0 0 1-2 2H9l-4.5 4V17H5a2 2 0 0 1-2-2Z" />
		</svg>
	)
}
{
	name === 'pin' && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
			<path d="M12 21s7-6.6 7-11.5A7 7 0 0 0 5 9.5C5 14.4 12 21 12 21Z" />
			<circle cx="12" cy="9.5" r="2.5" />
		</svg>
	)
}
{
	name === 'clock' && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
			<circle cx="12" cy="12" r="9.5" />
			<path d="M12 7v5l3.5 2" />
		</svg>
	)
}
{
	name === 'calendar' && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
			<rect x="2.5" y="4.5" width="19" height="17" rx="1" />
			<path d="M2.5 9.5h19" />
			<path d="M7 2.5v4M17 2.5v4" />
		</svg>
	)
}
{
	name === 'mail' && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
			<rect x="2.5" y="4.5" width="19" height="15" rx="1" />
			<path d="M3 6l9 7 9-7" />
		</svg>
	)
}
{
	name === 'phone' && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
			<path d="M5 3.5 8.5 3l2 5-2.3 2.3a12 12 0 0 0 5.5 5.5L16 13.5l5 2-.5 3.5a2 2 0 0 1-2 1.5C10.5 20 4 13.5 3.5 5.5a2 2 0 0 1 1.5-2Z" />
		</svg>
	)
}
{
	name === 'arrow' && (
		<svg viewBox="0 0 24 24" class={className} aria-hidden="true">
			<path d="M4 12h16M14 6l6 6-6 6" />
		</svg>
	)
}

<style>
	svg {
		width: 1.75rem;
		height: 1.75rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.25;
		stroke-linecap: round;
		stroke-linejoin: round;
		flex-shrink: 0;
	}
</style>
