---
export type V06IconName =
	| 'graduation'
	| 'briefcase'
	| 'chat'
	| 'pin'
	| 'clock'
	| 'calendar'
	| 'mail'
	| 'phone'
	| 'check'
	| 'arrow';

interface Props {
	name: V06IconName;
	size?: number;
	class?: string;
}

const { name, size = 28, class: className } = Astro.props;
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 48 48"
	fill="none"
	stroke="currentColor"
	stroke-width="2.75"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
>
	{
		name === 'graduation' && (
			<>
				<path d="M24 9 L43 18 L24 27 L5 18 Z" />
				<path d="M13 21.5 V31 C13 31 17.5 35.5 24 35.5 C30.5 35.5 35 31 35 31 V21.5" />
				<path d="M43 18 V29" />
				<circle cx="43" cy="32" r="1.8" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === 'briefcase' && (
			<>
				<rect x="6" y="17" width="36" height="22" rx="5.5" />
				<path d="M17.5 17 V12.5 C17.5 10 19.5 8 22 8 H26 C28.5 8 30.5 10 30.5 12.5 V17" />
				<path d="M6 27 H42" />
				<rect x="21" y="25" width="6" height="5" rx="1.5" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === 'chat' && (
			<>
				<path d="M8 11 H37 C40 11 42 13 42 16 V28 C42 31 40 33 37 33 H20 L11 41 V33 H8 C5 33 3 31 3 28 V16 C3 13 5 11 8 11 Z" />
				<circle cx="14" cy="22" r="1.9" fill="currentColor" stroke="none" />
				<circle cx="22.5" cy="22" r="1.9" fill="currentColor" stroke="none" />
				<circle cx="31" cy="22" r="1.9" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === 'pin' && (
			<>
				<path d="M24 4.5 C15 4.5 8.5 11 8.5 19.5 C8.5 30.5 24 43.5 24 43.5 C24 43.5 39.5 30.5 39.5 19.5 C39.5 11 33 4.5 24 4.5 Z" />
				<circle cx="24" cy="19.5" r="6" />
			</>
		)
	}
	{
		name === 'clock' && (
			<>
				<circle cx="24" cy="24" r="18.5" />
				<path d="M24 14 V24 L31 29" />
			</>
		)
	}
	{
		name === 'calendar' && (
			<>
				<rect x="6" y="10" width="36" height="32" rx="6" />
				<path d="M6 20 H42" />
				<path d="M15 5.5 V13.5" />
				<path d="M33 5.5 V13.5" />
				<circle cx="15" cy="28" r="1.8" fill="currentColor" stroke="none" />
				<circle cx="24" cy="28" r="1.8" fill="currentColor" stroke="none" />
				<circle cx="33" cy="28" r="1.8" fill="currentColor" stroke="none" />
				<circle cx="15" cy="34.5" r="1.8" fill="currentColor" stroke="none" />
				<circle cx="24" cy="34.5" r="1.8" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === 'mail' && (
			<>
				<rect x="4.5" y="10.5" width="39" height="27" rx="6" />
				<path d="M7 14 L24 27 L41 14" />
			</>
		)
	}
	{
		name === 'phone' && (
			<path d="M16.5 6.5 H22 L25 15 L20 18.5 C22.3 24.8 27 29.5 33.3 31.8 L36.5 27 L44.5 30 V36 C44.5 38.5 42.5 40.5 40 40.3 C21 38.8 9 26.8 7.5 7.8 C7.3 5.3 9.3 3.5 11.8 3.5 L16.5 6.5" />
		)
	}
	{
		name === 'check' && <path d="M8 24 L19 35 L40 12" />
	}
	{
		name === 'arrow' && <path d="M10 24 H38 M28 14 L38 24 L28 34" />
	}
</svg>
