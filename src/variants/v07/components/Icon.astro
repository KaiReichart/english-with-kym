---
/**
 * Minimal hairline icon set for variant 07. Self-contained — does not
 * import the shared src/components/Icon.astro.
 */
export type V07IconName =
	| 'graduation'
	| 'briefcase'
	| 'chat'
	| 'pin'
	| 'clock'
	| 'calendar'
	| 'mail'
	| 'phone'
	| 'arrow';

interface Props {
	name: V07IconName;
	class?: string;
}

const { name, class: className } = Astro.props;

const icons: Record<V07IconName, string> = {
	graduation:
		'<path d="M12 3.5 2.5 8l9.5 4.5L21.5 8 12 3.5Z"/><path d="M6.5 10.3V15c0 1.4 2.46 2.7 5.5 2.7s5.5-1.3 5.5-2.7v-4.7"/><path d="M21.5 8v5.6"/>',
	briefcase:
		'<rect x="3" y="7.2" width="18" height="11.3" rx="1.2"/><path d="M8.3 7.2V5.6a1.6 1.6 0 0 1 1.6-1.6h4.2a1.6 1.6 0 0 1 1.6 1.6v1.6"/><path d="M3 12.3h18"/>',
	chat: '<path d="M3.5 5.3a1.8 1.8 0 0 1 1.8-1.8h9.4a1.8 1.8 0 0 1 1.8 1.8v6a1.8 1.8 0 0 1-1.8 1.8h-4.6L6.9 15.8v-2.7H5.3a1.8 1.8 0 0 1-1.8-1.8v-6Z"/><circle cx="18" cy="16.2" r="2.8"/>',
	pin: '<path d="M12 21s6.5-6.1 6.5-11.2A6.5 6.5 0 0 0 5.5 9.8C5.5 14.9 12 21 12 21Z"/><circle cx="12" cy="9.6" r="2.2"/>',
	clock: '<circle cx="12" cy="12" r="8.3"/><path d="M12 7.6v4.7l3.2 1.9"/>',
	calendar:
		'<rect x="3.3" y="5" width="17.4" height="15.3" rx="1.2"/><path d="M3.3 9.6h17.4"/><path d="M8 3.3v3.4"/><path d="M16 3.3v3.4"/>',
	mail: '<rect x="3" y="5.3" width="18" height="13.4" rx="1.2"/><path d="M3.4 6.6 12 13l8.6-6.4"/>',
	phone:
		'<path d="M7 10.6a14.6 14.6 0 0 0 6.4 6.4l2-2a1.3 1.3 0 0 1 1.35-.32c1.2.4 2.5.62 3.85.62a1.3 1.3 0 0 1 1.3 1.3v3.1a1.3 1.3 0 0 1-1.3 1.3C10.98 21 3 13.02 3 2.8A1.3 1.3 0 0 1 4.3 1.5h3.1a1.3 1.3 0 0 1 1.3 1.3c0 1.35.22 2.65.62 3.85a1.3 1.3 0 0 1-.32 1.35l-1.98 2.0Z"/>',
	arrow: '<path d="M4 12h15.2"/><path d="M13.6 6.4 19.2 12l-5.6 5.6"/>',
};
---

<svg
	class={`v07-icon ${className ?? ''}`}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.1"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={icons[name]}
/>

<style>
	.v07-icon {
		width: 1.5em;
		height: 1.5em;
		flex-shrink: 0;
	}
</style>
