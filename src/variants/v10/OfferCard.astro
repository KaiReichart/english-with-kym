---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { OfferCardContent } from '../../i18n/types';

interface Props {
	offer: OfferCardContent;
	image: ImageMetadata;
	index: string;
	reverse?: boolean;
}

const { offer, image, index, reverse = false } = Astro.props;
---

<article class={`offer-card ${reverse ? 'offer-card--reverse' : ''}`}>
	<div class="offer-card__media">
		<div class="offer-card__frame">
			<Image src={image} alt={offer.imageAlt} width={560} format="webp" />
		</div>
	</div>
	<div class="offer-card__body">
		<span class="offer-card__index" aria-hidden="true">{index}</span>
		<Icon name={offer.icon} class="offer-card__icon" />
		<h3 class="offer-card__title">{offer.title}</h3>
		<p class="offer-card__subtitle">{offer.subtitle}</p>

		{offer.intro.map((p) => <p class="offer-card__text">{p}</p>)}

		{offer.leadIn && <p class="offer-card__leadin">{offer.leadIn}</p>}

		{
			offer.bullets && (
				<ul class="offer-card__bullets">
					{offer.bullets.map((b) => <li>{b}</li>)}
				</ul>
			)
		}

		{offer.outro.map((p) => <p class="offer-card__text">{p}</p>)}
	</div>
</article>

<style>
	.offer-card {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.75rem;
		padding-block: 2.5rem;
		border-top: 1px solid var(--stone);
	}

	@media (min-width: 860px) {
		.offer-card {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
			gap: 3.5rem;
			align-items: start;
		}

		.offer-card--reverse {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
		}

		.offer-card--reverse .offer-card__media {
			order: 2;
		}
	}

	.offer-card__frame {
		overflow: hidden;
		border-radius: 1.25rem;
		background: var(--paper);
		border: 1px solid var(--stone);
	}

	.offer-card__frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
		filter: saturate(0.82) sepia(0.06);
	}

	.offer-card__index {
		display: block;
		font-family: 'DM Serif Display', serif;
		font-size: 0.95rem;
		letter-spacing: 0.08em;
		color: var(--sage-dark);
		margin-bottom: 0.75rem;
	}

	.offer-card__icon {
		width: 2rem;
		height: 2rem;
		color: var(--sage-dark);
		margin-bottom: 0.9rem;
	}

	.offer-card__title {
		font-family: 'DM Serif Display', serif;
		font-size: clamp(1.5rem, 1.1rem + 1vw, 1.9rem);
		font-weight: 400;
		color: var(--charcoal);
		margin: 0 0 0.35rem;
		line-height: 1.2;
	}

	.offer-card__subtitle {
		font-size: 1rem;
		color: var(--sage-dark);
		margin: 0 0 1.25rem;
	}

	.offer-card__text {
		color: var(--charcoal-soft);
		line-height: 1.75;
		margin: 0 0 1rem;
		max-width: 38em;
	}

	.offer-card__leadin {
		color: var(--charcoal);
		font-weight: 500;
		margin: 0 0 0.9rem;
	}

	.offer-card__bullets {
		list-style: none;
		margin: 0 0 1.25rem;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}

	.offer-card__bullets li {
		position: relative;
		padding-left: 1.4rem;
		color: var(--charcoal-soft);
		line-height: 1.5;
	}

	.offer-card__bullets li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--sage);
	}
</style>
