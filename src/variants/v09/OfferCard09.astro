---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { OfferCardContent } from '../../i18n/types';
import Icon09 from './Icon09.astro';

interface Props {
	card: OfferCardContent;
	image: ImageMetadata;
	index: string;
}

const { card, image, index } = Astro.props;
---

<article class="offer-card">
	<div class="offer-media">
		<Image src={image} alt={card.imageAlt} width={560} height={420} format="webp" class="offer-img" />
		<span class="offer-index" aria-hidden="true">{index}</span>
	</div>
	<div class="offer-body">
		<div class="offer-icon">
			<Icon09 name={card.icon} />
		</div>
		<h3 class="offer-title">{card.title}</h3>
		<p class="offer-subtitle">{card.subtitle}</p>
		{card.intro.map((p) => <p>{p}</p>)}
		{
			card.bullets && (
				<>
					{card.leadIn && <p class="offer-leadin">{card.leadIn}</p>}
					<ul class="offer-bullets">
						{card.bullets.map((b) => (
							<li>{b}</li>
						))}
					</ul>
				</>
			)
		}
		{card.outro.map((p) => <p>{p}</p>)}
	</div>
</article>

<style>
	.offer-card {
		background: var(--cream, #f4e3c1);
		border: 3px solid var(--brown, #4a2a18);
		border-radius: 28px;
		overflow: hidden;
		box-shadow: 8px 8px 0 var(--brown, #4a2a18);
		display: flex;
		flex-direction: column;
	}

	.offer-media {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-bottom: 3px solid var(--brown, #4a2a18);
	}

	.offer-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: sepia(0.35) saturate(1.3) contrast(1.05);
	}

	.offer-index {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		font-family: 'Bebas Neue', sans-serif;
		font-size: 1.6rem;
		letter-spacing: 0.05em;
		color: var(--brown, #4a2a18);
		background: var(--mustard, #e8a33d);
		border: 2px solid var(--brown, #4a2a18);
		border-radius: 999px;
		width: 2.4rem;
		height: 2.4rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.offer-body {
		padding: 1.5rem 1.5rem 1.75rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.offer-icon {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: var(--orange, #d9622b);
		color: var(--cream, #f4e3c1);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.offer-title {
		font-family: 'Shrikhand', cursive;
		font-size: 1.5rem;
		color: var(--rust, #a8401e);
		margin: 0;
		line-height: 1.15;
	}

	.offer-subtitle {
		font-family: 'Bebas Neue', sans-serif;
		letter-spacing: 0.04em;
		font-size: 1rem;
		color: var(--brown, #4a2a18);
		margin: -0.4rem 0 0.25rem;
	}

	.offer-body p {
		margin: 0;
		line-height: 1.55;
		color: var(--brown, #3a2415);
	}

	.offer-leadin {
		font-weight: 700;
	}

	.offer-bullets {
		margin: 0;
		padding-left: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.offer-bullets li {
		position: relative;
		padding-left: 1.5rem;
		line-height: 1.45;
		color: var(--brown, #3a2415);
	}

	.offer-bullets li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.45em;
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: var(--orange, #d9622b);
		border: 1.5px solid var(--brown, #4a2a18);
	}
</style>
