---
import type { IconName } from '../../i18n/types';

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className } = Astro.props;

const icons: Record<IconName, string> = {
	graduation:
		'<path d="M12 4 3 9l9 4 9-4-9-5Z"/><path d="M7 11.5V17c0 1.4 2.3 2.6 5 2.6s5-1.2 5-2.6v-5.5"/><path d="M21 9v6.5"/>',
	briefcase:
		'<rect x="3.5" y="8" width="17" height="11" rx="2.2"/><path d="M8.5 8V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v2"/><path d="M3.5 13h17"/>',
	chat: '<path d="M4 5.5a2 2 0 0 1 2-2h8.5a2 2 0 0 1 2 2v5.5a2 2 0 0 1-2 2h-4.3L7 16.5v-3.5H6a2 2 0 0 1-2-2V5.5Z"/><circle cx="18.3" cy="16" r="3"/>',
	pin: '<path d="M12 21s6.5-6.1 6.5-11.3A6.5 6.5 0 0 0 5.5 9.7C5.5 14.9 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.3"/>',
	clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v4.8l3.2 1.9"/>',
	calendar:
		'<rect x="3.5" y="5.5" width="17" height="15" rx="2.2"/><path d="M3.5 10.5h17"/><path d="M8 3.5v4"/><path d="M16 3.5v4"/>',
	mail: '<rect x="3.2" y="5.5" width="17.6" height="13" rx="2"/><path d="M3.8 6.7 12 13l8.2-6.3"/>',
	phone: '<path d="M6.3 10.3a15.3 15.3 0 0 0 6.4 6.4l2.1-2.1a1.4 1.4 0 0 1 1.4-.4c1.3.4 2.6.6 4 .6a1.4 1.4 0 0 1 1.4 1.4v3.3a1.4 1.4 0 0 1-1.4 1.4C10.4 20.9 2 12.5 2 2.7A1.4 1.4 0 0 1 3.4 1.3h3.3A1.4 1.4 0 0 1 8.1 2.7c0 1.4.2 2.7.6 4a1.4 1.4 0 0 1-.4 1.4L6.3 10.3Z"/>',
};
---

<svg
	class={`icon09 ${className ?? ''}`}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	focusable="false"
	set:html={icons[name]}
/>

<style>
	.icon09 {
		width: 1.6em;
		height: 1.6em;
		flex-shrink: 0;
	}
</style>
