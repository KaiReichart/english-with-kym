---
import type { IconName } from '../copy';

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className } = Astro.props;
---

{
	name === 'graduation' && (
		<svg class={className} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M4 18 24 9l20 9-20 9L4 18Z" />
			<path d="M13 22.5v9c0 2.8 4.9 5 11 5s11-2.2 11-5v-9" />
			<path d="M40 19v11" />
		</svg>
	)
}
{
	name === 'briefcase' && (
		<svg class={className} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="6" y="15" width="36" height="24" rx="2.5" />
			<path d="M17 15v-4a3 3 0 0 1 3-3h8a3 3 0 0 1 3 3v4" />
			<path d="M6 25h36" />
			<path d="M21 25h6v4h-6z" />
		</svg>
	)
}
{
	name === 'chat' && (
		<svg class={className} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M6 10.5A3.5 3.5 0 0 1 9.5 7h29A3.5 3.5 0 0 1 42 10.5v17A3.5 3.5 0 0 1 38.5 31H20l-9 8v-8H9.5A3.5 3.5 0 0 1 6 27.5v-17Z" />
			<path d="M15 16h18M15 23h11" />
		</svg>
	)
}
{
	name === 'pin' && (
		<svg class={className} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M24 43S9 28.4 9 18a15 15 0 0 1 30 0c0 10.4-15 25-15 25Z" />
			<circle cx="24" cy="18" r="5.5" />
		</svg>
	)
}
{
	name === 'clock' && (
		<svg class={className} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="24" cy="24" r="18" />
			<path d="M24 14v10l7 5" />
		</svg>
	)
}
{
	name === 'calendar' && (
		<svg class={className} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="7" y="10" width="34" height="30" rx="2.5" />
			<path d="M7 19h34" />
			<path d="M15 6v8M33 6v8" />
			<path d="M15 27h6M15 33h12" />
		</svg>
	)
}
{
	name === 'duo' && (
		<svg class={className} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="17" cy="16" r="6" />
			<path d="M6 40c0-7.5 5-12 11-12s11 4.5 11 12" />
			<circle cx="34" cy="14" r="4.5" stroke-dasharray="3 3" />
			<path d="M28 40c.5-6 3.5-10 8-10.5" stroke-dasharray="3 3" />
		</svg>
	)
}
{
	name === 'mail' && (
		<svg class={className} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="5" y="10" width="38" height="28" rx="2.5" />
			<path d="M6 13l18 14L42 13" />
		</svg>
	)
}
{
	name === 'phone' && (
		<svg class={className} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M10 6h7l3 9-5 3c1.8 4.3 5 7.5 9.3 9.3l3-5 9 3v7c0 1.9-1.7 3.4-3.6 3.1C18.6 34.4 9.6 25.4 6.9 12.6 6.6 10.7 8.1 9 10 9Z" transform="translate(0 -3)" />
		</svg>
	)
}
{
	name === 'arrow' && (
		<svg class={className} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M6 24h36M28 10l14 14-14 14" />
		</svg>
	)
}
{
	name === 'check' && (
		<svg class={className} viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="M4 10.5 8 14l8-9" />
		</svg>
	)
}
