---
interface Props {
	number: string;
}

const { number } = Astro.props;
---

<p class="kicker" aria-hidden="true">
	<span class="kicker-num">{number}</span>
	<span class="kicker-rule"></span>
</p>

<style>
	.kicker {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 1.5rem;
		font-family: var(--font-label);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.kicker-num {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1rem;
		letter-spacing: 0;
		color: var(--ink);
	}

	.kicker-rule {
		width: 2.5rem;
		height: 1px;
		background: currentColor;
		flex: none;
	}
</style>
