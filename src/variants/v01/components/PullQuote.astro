---
interface Props {
	quote: string;
}

const { quote } = Astro.props;
---

<figure class="pullquote" aria-hidden="true">
	<svg class="mark" viewBox="0 0 32 24" focusable="false">
		<path
			d="M9.5 0C4.3 2.6 0 8 0 14.2 0 19.7 3.6 24 8.8 24c4 0 7-3 7-6.8 0-3.6-2.6-6.3-6-6.3-.7 0-1.3.1-1.8.3C8.6 6.8 11.6 3 16 0.9L9.5 0Zm16 0C20.3 2.6 16 8 16 14.2c0 5.5 3.6 9.8 8.8 9.8 4 0 7-3 7-6.8 0-3.6-2.6-6.3-6-6.3-.7 0-1.3.1-1.8.3 1.4-4.4 4.4-8.2 8.8-10.3L25.5 0Z"
			fill="currentColor"
		></path>
	</svg>
	<blockquote>
		<p>{quote}</p>
	</blockquote>
</figure>

<style>
	.pullquote {
		margin: 2.5rem 0;
		padding-left: 1.75rem;
		border-left: 2px solid var(--accent);
		column-span: all;
	}

	.mark {
		width: 2rem;
		height: 1.5rem;
		color: var(--accent);
		opacity: 0.6;
		display: block;
		margin-bottom: 0.5rem;
	}

	blockquote {
		margin: 0;
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 440;
		font-size: clamp(1.25rem, 1rem + 1.2vw, 1.75rem);
		line-height: 1.35;
		color: var(--ink);
		max-width: 34ch;
	}
</style>
