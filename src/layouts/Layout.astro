---
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	lang: 'de' | 'en';
	title: string;
	description: string;
	skipLink: string;
	nav: { offer: string; about: string; lessons: string; contact: string };
	switchLabel: string;
	footer: { tagline: string; impressum: string; datenschutz: string; rights: string };
	hasAlternates?: boolean;
}

const { lang, title, description, skipLink, nav, switchLabel, footer, hasAlternates } = Astro.props;

const otherLang = lang === 'de' ? 'en' : 'de';
// While the design variants are being reviewed, "/" is the variant grid and the
// original German homepage lives at /v/00/.
const deHomePath = '/v/00/';
const localeHome = (l: 'de' | 'en') => getRelativeLocaleUrl(l, l === 'de' ? deHomePath : '/');
const homeHref = localeHome(lang);
const otherLangHref = localeHome(otherLang);
const alternates = hasAlternates
	? { de: getAbsoluteLocaleUrl('de', deHomePath), en: getAbsoluteLocaleUrl('en', '/') }
	: undefined;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="canonical" href={canonicalURL} />
		{
			alternates && (
				<>
					<link rel="alternate" hreflang="de" href={alternates.de} />
					<link rel="alternate" hreflang="en" href={alternates.en} />
					<link rel="alternate" hreflang="x-default" href={alternates.de} />
				</>
			)
		}
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<a class="skip-link" href="#main">{skipLink}</a>
		<Header lang={lang} nav={nav} switchLabel={switchLabel} homeHref={homeHref} otherLangHref={otherLangHref} />
		<main id="main">
			<slot />
		</main>
		<Footer footer={footer} />
	</body>
</html>
